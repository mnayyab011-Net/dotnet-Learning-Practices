
@{
    Layout = null;
}
@model LoginWebsite.Models.RegisterModel

@{
    ViewData["Title"] = "Create Account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create Account</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="login-card">
        <h2>Create your account</h2>
        <p class="subtitle">Sign up to continue</p>
        @if (TempData["Success"] != null)
        {
            <div class="success-box">
                @TempData["Success"]
            </div>
        }
        <form asp-action="Register" method="post">
            <div class="form-group">
                <input asp-for="FullName" placeholder="Full Name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="Email" placeholder="Email Address" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="Username" placeholder="Username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="Password" type="password" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit">Create Account</button>
        </form>
        <div class="bottom-text">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Sign in</a>
        </div>
    </div>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>