@{
    ViewData["Title"] = "Dashboard";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Dashboard</title>
    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Segoe UI',sans-serif;
        }
        body{
            background:#f3f3f3;
        }
        .navbar{
            background:white;
            height:70px;
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:0 40px;
            box-shadow:0 2px 10px rgba(0,0,0,.1);
        }
        .logo{
            color:#0067B8;
            font-size:28px;
            font-weight:bold;
        }
        .menu a{
            text-decoration:none;
            color:#333;
            margin-left:30px;
            font-weight:600;
        }
        .menu a:hover{
            color:#0067B8;
        }
        .container{
            width:90%;
            margin:40px auto;
        }
        h1{
            margin-bottom:10px;
        }
        .cards{
            display:grid;
            grid-template-columns:repeat(3,1fr);
            gap:25px;
            margin-top:30px;
        }
        .card{
            background:white;
            padding:30px;
            border-radius:12px;
            box-shadow:0 5px 15px rgba(0,0,0,.1);
        }
        .card h2{
            color:#0067B8;
            margin-bottom:15px;
        }
        .card p{
            color:#666;
        }
        .logout{
            background:#0067B8;
            color:white !important;
            padding:10px 20px;
            border-radius:6px;
        }
        .logout:hover{
            background:#004e8c;
        }
    </style>
</head>
<body>
<div class="navbar">
    <div class="logo">
        Login Website
    </div>
    <div class="menu">
        <a href="#">Home</a>
        <a href="#">Profile</a>
        <a href="#">Settings</a>
        <a asp-controller="Account"
           asp-action="Logout"
           class="logout">
            Logout
        </a>
    </div>
</div>
<div class="container">
    <h1>Welcome, @User.Identity?.Name 👋</h1>
    <p>You have successfully logged into the system.</p>
    <div class="cards">
        <div class="card">
            <h2>Users</h2>
            <p>Manage application users.</p>
        </div>
        <div class="card">
            <h2>Reports</h2>
            <p>View system reports and analytics.</p>
        </div>
        <div class="card">
            <h2>Settings</h2>
            <p>Configure your account preferences.</p>
        </div>
    </div>
</div>
</body>
</html>