@model IEnumerable<LoginWebsite.Models.User>
@{
    Layout = null;
    ViewData["Title"] = "Users";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Users Management</title>
    <link rel="stylesheet" href="~/css/style.css" />
    <style>
        body{
            background:#f3f2f1;
            font-family:"Segoe UI",sans-serif;
        }
    .navbar{
            background:#0067b8;
            color:white;
            padding:20px 40px;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }
        .navbar a{
            background:white;
            color:#0067b8;
            padding:10px 18px;
            border-radius:5px;
            text-decoration:none;
            font-weight:600;
        }
        .container{
            width:90%;
            margin:40px auto;
        }
        .header{
            display:flex;
            justify-content:space-between;
            align-items:center;
            margin-bottom:25px;
        }
        .add-btn{
            background:#0067b8;
            color:white;
            padding:12px 20px;
            border-radius:5px;
            text-decoration:none;
        }
        table{
            width:100%;
            background:white;
            border-collapse:collapse;
            box-shadow:0 5px 20px rgba(0,0,0,.1);
        }
        th{
            background:#0067b8;
            color:white;
            padding:15px;
            text-align:left;
        }
        td{
            padding:15px;
            border-bottom:1px solid #ddd;
        }
        .edit{
            color:green;
            text-decoration:none;
            margin-right:15px;
            font-weight:600;
        }
        .delete{
            color:red;
            text-decoration:none;
            font-weight:600;
        }
    </style>
</head>
<body>
<div class="navbar">
    <h2>
        Users Management
    </h2>
    <a asp-controller="Home"
       asp-action="Index">
        Dashboard
    </a>
</div>
   <div class="users-container">
    <div class="users-header">
        <h2 class="users-title">
            Registered Users
        </h2>
        <a class="add-user-btn">
            + Add User
        </a>
    </div>
    <table class="user-table">
        ...
    </table>
</div>
    <table>
        <thead>
         <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Username</th>
               <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var user in Model)
        {

            <tr>
                <td>
                    @user.Id
                </td>
                <td>
                    @user.FullName
                </td>
                <td>
                    @user.Email
                </td>
                <td>
                    @user.Username
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="edit">
                        Edit
                  </a>
                    <a asp-action="Delete"
                       asp-route-id="@user.Id"
                       class="delete">
                        Delete
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
</body>
</html>